# Database Connection (SQLite default, switch to postgresql://user:pass@localhost:5432/editflow for PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Secret for signing HTTP-only auth cookies
JWT_SECRET="your-super-secret-jwt-key-here"

# Optional OpenAI API Key for AI Video Assistant (Intelligent fallback active if empty)
OPENAI_API_KEY=""

# Optional Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Redis Connection for BullMQ background workers
REDIS_URL="redis://localhost:6379"
